# ==========================================
# Keepr Environment Configuration
# ==========================================

# Gemini AI API Key (Server-Side)
# Required for AI-assisted features and intelligent note summarization
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Base URL
# Used for OAuth redirect URI construction and preview linking
APP_URL="http://localhost:3000"

# Supabase Configuration
# Required for PostgreSQL Database, Supabase Auth, and Storage Buckets
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
